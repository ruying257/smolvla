<mujoco model="smolvla mug placement scene">
  <!--
    与双积木cube_scene.xml并行存在的杯子场景。机器人、桌面、相机、背景和两个
    放置区域沿用原场景参数；任务物体改为ACT mug_5可交互杯子。
  -->
  <include file="ur10e_with_2f85_d435i.xml"/>
  <include file="./tabletop/object/object_table.xml"/>
  <include file="./mug_5/model_smolvla.xml"/>

  <statistic center="0.4 0 0.4" extent="1"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- ACT演示场景中的世界原点和RGB坐标轴。 -->
    <geom name="world_origin" type="sphere" size="0.02" pos="0 0 0"
          rgba="1 1 1 1" contype="0" conaffinity="0" mass="0" group="1"/>
    <geom name="world_axis_x" type="cylinder" size="0.005 0.15" pos="0.15 0 0.8"
          euler="0 1.5708 0" rgba="1 0 0 1" contype="0" conaffinity="0"
          mass="0" group="1"/>
    <geom name="world_axis_y" type="cylinder" size="0.005 0.15" pos="0 0.15 0.8"
          euler="-1.5708 0 0" rgba="0 1 0 1" contype="0" conaffinity="0"
          mass="0" group="1"/>
    <geom name="world_axis_z" type="cylinder" size="0.005 0.15" pos="0 0 0.97"
          euler="0 0 0" rgba="0 0 1 1" contype="0" conaffinity="0"
          mass="0" group="1"/>

    <!-- 两个区域只提供视觉提示，不参与碰撞或动力学计算。 -->
    <body name="task_blue_pad" pos="0.55 -0.22 0.8005">
      <geom name="task_blue_pad_geom" type="box" size="0.08 0.06 0.001"
            rgba="0.1 0.3 0.9 0.65" contype="0" conaffinity="0" mass="0" group="2"/>
    </body>
    <body name="task_yellow_pad" pos="0.55 0.22 0.8005">
      <geom name="task_yellow_pad_geom" type="box" size="0.08 0.06 0.001"
            rgba="0.95 0.8 0.1 0.65" contype="0" conaffinity="0" mass="0" group="2"/>
    </body>
  </worldbody>
</mujoco>
